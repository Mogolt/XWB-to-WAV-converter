<Window x:Class="XwbStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:XwbStudio.Views"
        Title="XWB Studio"
        Width="1060" Height="700" MinWidth="920" MinHeight="600"
        Background="{StaticResource BgBrush}"
        FontFamily="Consolas"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Opacity="0">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Accent strip -->
        <Border Grid.Row="0" Background="{StaticResource AccentGradient}"/>

        <!-- Header -->
        <Grid Grid.Row="1" Margin="24,14,24,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="XWB STUDIO" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="XACT wave-bank toolkit · for RE4 &amp; friends" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="14,7,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                    Content="?" FontSize="15" FontWeight="Bold" Padding="13,4"
                    Click="HelpClick"/>
        </Grid>

        <!-- Tab bar with sliding indicator -->
        <Grid Grid.Row="2" Margin="14,2,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="1"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <RadioButton x:Name="TabExtract" Style="{StaticResource TabButton}" GroupName="tabs"
                             Content="Extract" IsChecked="True" Checked="TabChecked"/>
                <RadioButton x:Name="TabConvert" Style="{StaticResource TabButton}" GroupName="tabs"
                             Content="Convert" Checked="TabChecked"/>
                <RadioButton x:Name="TabInject" Style="{StaticResource TabButton}" GroupName="tabs"
                             Content="Inject" Checked="TabChecked"/>
            </StackPanel>

            <Canvas Grid.Row="1" x:Name="IndicatorCanvas">
                <Border x:Name="TabIndicator" Height="3" Width="0" Canvas.Left="0"
                        Background="{StaticResource AccentGradient}" CornerRadius="1.5"/>
            </Canvas>

            <Border Grid.Row="2" Background="{StaticResource LineBrush}" Margin="2,0"/>
        </Grid>

        <!-- Tab content -->
        <Grid Grid.Row="3" x:Name="ContentHost">
            <views:ExtractView x:Name="ExtractTab" DataContext="{Binding Extract}">
                <views:ExtractView.RenderTransform>
                    <TranslateTransform/>
                </views:ExtractView.RenderTransform>
            </views:ExtractView>
            <views:ConvertView x:Name="ConvertTab" DataContext="{Binding Convert}" Visibility="Collapsed">
                <views:ConvertView.RenderTransform>
                    <TranslateTransform/>
                </views:ConvertView.RenderTransform>
            </views:ConvertView>
            <views:InjectView x:Name="InjectTab" DataContext="{Binding Inject}" Visibility="Collapsed">
                <views:InjectView.RenderTransform>
                    <TranslateTransform/>
                </views:InjectView.RenderTransform>
            </views:InjectView>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}">
            <Grid Margin="12,5">
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="v2.0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           Opacity="0.6" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Help overlay -->
        <Grid x:Name="HelpOverlay" Grid.RowSpan="5" Visibility="Collapsed" Opacity="0">
            <Border Background="#C80D0D18" MouseLeftButtonDown="HelpScrimClick"/>
            <Border x:Name="HelpCard" Width="600" MaxHeight="540" VerticalAlignment="Center"
                    Background="{StaticResource BgBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource PanelHoverBrush}" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform Y="26"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource AccentGradient}" CornerRadius="10,10,0,0"/>
                    <ScrollViewer Grid.Row="1" Margin="28,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Foreground="{StaticResource AccentBrush}" Text="Extract"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="10,4,0,14" FontSize="12" Foreground="{StaticResource TextBrush}"
                                       Text="1. Set your XWB folder and output folder.&#10;2. Optionally load a config.json for custom track names.&#10;3. Click Extract All to dump every track from every .xwb file.&#10;4. Tick Individual Extraction to browse a single XWB, preview tracks, and extract only the ones you want."/>
                            <TextBlock Style="{StaticResource SectionTitle}" Foreground="{StaticResource AccentBrush}" Text="Convert"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="10,4,0,14" FontSize="12" Foreground="{StaticResource TextBrush}"
                                       Text="1. Add WAV files or a whole folder (drag &amp; drop works).&#10;2. Set an output .xwb path and bank name.&#10;3. Click Convert to XWB to bundle them into a new wave bank."/>
                            <TextBlock Style="{StaticResource SectionTitle}" Foreground="{StaticResource AccentBrush}" Text="Inject"/>
                            <TextBlock Style="{StaticResource HintText}" Margin="10,4,0,4" FontSize="12" Foreground="{StaticResource TextBrush}"
                                       Text="1. Browse and load an XWB file.&#10;2. Select a track from the list and preview it.&#10;3. Browse a replacement WAV file.&#10;4. Click Replace &amp; Rebuild to overwrite or save to a new folder."/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Style="{StaticResource FlatButton}" Content="Close"
                            HorizontalAlignment="Center" Margin="0,0,0,18" Padding="22,7"
                            Click="HelpCloseClick"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
