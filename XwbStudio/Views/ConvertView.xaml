<UserControl x:Class="XwbStudio.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,8,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" FontSize="16" Text="WAV → XWB Converter"/>
        <TextBlock Grid.Row="1" Style="{StaticResource HintText}" Margin="0,2,0,10"
                   Text="Bundle WAV files into a new XWB bank  (PCM only) — drag &amp; drop works too"/>

        <!-- File list -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="6"
                AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
            <Grid>
                <ListBox Style="{StaticResource DarkListBox}" SelectionMode="Extended"
                         Background="Transparent"
                         ItemsSource="{Binding Files}"
                         ItemContainerStyle="{StaticResource TrackListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,6,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}" Content="+ Add WAV Files" Command="{Binding AddFilesCommand}"/>
                <Button Style="{StaticResource FlatButton}" Content="+ Add Folder" Margin="6,0,0,0" Command="{Binding AddFolderCommand}"/>
                <Button Style="{StaticResource FlatButton}" Content="✕ Remove Selected" Margin="6,0,0,0" Command="{Binding RemoveSelectedCommand}"/>
                <Button Style="{StaticResource FlatButton}" Content="Clear All" Margin="6,0,0,0" Command="{Binding ClearAllCommand}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource HintText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding FileCountText}"/>
        </Grid>

        <!-- Output path -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Output XWB:"/>
            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                     Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                     Tag="where to save the new .xwb"/>
            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                    Content="Browse" Command="{Binding BrowseOutputCommand}"/>
        </Grid>

        <!-- Bank name -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Bank Name:"/>
            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                     Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource HintText}" VerticalAlignment="Center"
                       Margin="10,0,0,0" Text="(name stored inside the XWB file)"/>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Command="{Binding ConvertCommand}" IsEnabled="{Binding IsIdle}" Padding="20,9">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                        <Setter Property="Content" Value="⬇  Convert to XWB"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                <Setter Property="Content" Value="Converting..."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Style="{StaticResource SuccessButton}" Content="📂  Open Output Folder" Margin="8,0,0,0"
                    Padding="20,9" Command="{Binding OpenFolderCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="7" Margin="0,8,0,0" HorizontalAlignment="Center"
                   FontFamily="Consolas" FontSize="12"
                   Text="{Binding StatusText}"
                   Foreground="{Binding StatusKind, Converter={StaticResource KindToBrush}}"/>
    </Grid>
</UserControl>
