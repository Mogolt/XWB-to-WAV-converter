<UserControl x:Class="XwbStudio.Views.InjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24,8,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- XWB picker -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="XWB File:"/>
            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                     Text="{Binding XwbPath, UpdateSourceTrigger=PropertyChanged}"
                     Tag="the wave bank to modify"/>
            <Button Grid.Column="2" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                    Content="Browse" Command="{Binding BrowseXwbCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Track list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Tracks in XWB"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="12,3,0,0" Text="{Binding LoadHint}"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6">
                    <ListBox Style="{StaticResource DarkListBox}" SelectionMode="Single"
                             ItemsSource="{Binding Tracks}"
                             SelectedItem="{Binding SelectedTrack}"
                             ItemContainerStyle="{StaticResource TrackListItem}"
                             ItemTemplate="{StaticResource TrackRow}"/>
                </Border>

                <Button Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Command="{Binding PreviewCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                            <Setter Property="Content" Value="▶  Preview Selected"/>
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPreviewPlaying}" Value="True">
                                    <Setter Property="Content" Value="■  Stop"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}" Margin="16,4"/>

            <!-- Replace panel -->
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Replace With" Margin="0,0,0,8"/>

                <Border Background="{StaticResource DeepBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" Text="{Binding SelectedInfo}"/>
                </Border>

                <TextBlock Style="{StaticResource HintText}" Text="Custom WAV:"/>
                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,3,0,4"
                         Text="{Binding WavPath, UpdateSourceTrigger=PropertyChanged}"
                         Tag="replacement .wav file"/>
                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                        Content="Browse WAV" Command="{Binding BrowseWavCommand}"/>

                <CheckBox Style="{StaticResource DarkCheckBox}" Margin="0,16,0,4"
                          Content="Save to separate folder"
                          IsChecked="{Binding SaveToSeparateFolder}"/>

                <StackPanel Visibility="{Binding SaveToSeparateFolder, Converter={StaticResource BoolToVis}}">
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,2,0,4"
                             Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                             Tag="output folder"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource FlatButton}" Padding="10,5"
                                Content="Browse" Command="{Binding BrowseOutputFolderCommand}"/>
                        <Button Style="{StaticResource SuccessButton}" Padding="10,5" Margin="6,0,0,0"
                                Content="📂" Command="{Binding OpenOutputFolderCommand}"/>
                    </StackPanel>
                </StackPanel>

                <Button Margin="0,14,0,0" HorizontalAlignment="Left" Padding="16,9"
                        Command="{Binding ReplaceCommand}"
                        IsEnabled="{Binding IsArmed}"
                        Tag="{Binding IsArmed, Converter={StaticResource PulseWhenTrue}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                            <Setter Property="Content" Value="⬇  Replace &amp; Rebuild"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                    <Setter Property="Content" Value="Working..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Margin="0,10,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                           Text="{Binding StatusText}"
                           Foreground="{Binding StatusKind, Converter={StaticResource KindToBrush}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
